ANTHROPIC_API_KEY=
PUTIO_CLIENT_ID=
PUTIO_CLIENT_SECRET=
# 32 characters or more
SESSION_SECRET=
# Optional; defaults in src/server/config.ts
# MODEL=claude-sonnet-5-5
# MONTHLY_CREDITS=300
# POOL_BUDGET_CREDITS=19000
# Optional; all three let translations fetch English subtitles put.io lacks (opensubtitles.com account)
# OPENSUBTITLES_API_KEY=
# OPENSUBTITLES_USERNAME=
# OPENSUBTITLES_PASSWORD=
# Comma-separated put.io usernames with no personal cap
# UNLIMITED_USERS=
# Deploy only: Alchemy's Cloudflare auth comes from the shell, never bound to the Worker.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

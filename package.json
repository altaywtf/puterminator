{
  "name": "puterminator",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build && DO_NOT_TRACK=1 alchemy dev --stage dev",
    "dev:fake": "vite build && PORTLESS_PORT=1355 portless run node src/server/testing/dev-fake.ts",
    "dev:client": "vite",
    "lab": "vite --port 5174 --strictPort",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "plan": "vite build && DO_NOT_TRACK=1 alchemy plan --stage prod",
    "deploy": "pnpm verify && DO_NOT_TRACK=1 alchemy deploy --stage prod",
    "lint": "oxlint",
    "knip": "knip",
    "verify": "pnpm typecheck && pnpm lint && pnpm knip && pnpm test && pnpm build"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@anthropic-ai/sdk": "1.3.0",
    "@effect/platform-browser": "catalog:",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@putdotio/sdk": "13.3.1",
    "alchemy": "2.0.0-beta.84",
    "effect": "catalog:",
    "foldkit": "0.169.0",
    "hls.js": "1.7.4",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@foldkit/vite-plugin": "0.28.0",
    "@oxlint/plugins": "1.90.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@uinaf/oxlint-plugin-no-comments": "1.0.1",
    "knip": "6.44.1",
    "oxlint": "1.90.0",
    "portless": "0.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

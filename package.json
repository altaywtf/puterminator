{
  "name": "puterminator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build && DO_NOT_TRACK=1 alchemy dev --stage dev",
    "dev:fake": "vite build && node src/server/testing/dev-fake.ts",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "plan": "vite build && DO_NOT_TRACK=1 alchemy plan --stage prod",
    "deploy": "pnpm typecheck && pnpm test && vite build && DO_NOT_TRACK=1 alchemy deploy --stage prod"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@anthropic-ai/sdk": "1.3.0",
    "@effect/platform-browser": "4.0.7",
    "@putdotio/sdk": "13.3.1",
    "@uinaf/design": "1.17.8",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.7",
    "foldkit": "0.169.0",
    "hls.js": "1.6.15",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.7",
    "@foldkit/vite-plugin": "0.28.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

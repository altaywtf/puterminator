{
  "name": "puterminator",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite build && DO_NOT_TRACK=1 alchemy dev --stage dev",
    "dev:fake": "vite build && PORTLESS_PORT=1355 portless run node src/server/testing/dev-fake.ts",
    "dev:client": "vite",
    "lab": "vite --port 5174 --strictPort",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "plan": "vite build && DO_NOT_TRACK=1 alchemy plan --stage prod",
    "deploy": "pnpm verify && DO_NOT_TRACK=1 alchemy deploy --stage prod",
    "lint": "oxlint",
    "knip": "knip",
    "verify": "pnpm typecheck && pnpm lint && pnpm knip && pnpm test && pnpm build",
    "ex": "node workshop/scripts/ex.ts",
    "pi": "node workshop/scripts/pi.ts"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@anthropic-ai/sdk": "1.14.0",
    "@effect/platform-browser": "catalog:",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@putdotio/sdk": "17.0.1",
    "@xstate/effect": "1.0.0-beta.3",
    "alchemy": "2.0.0-beta.87",
    "effect": "catalog:",
    "foldkit": "0.171.0",
    "hls.js": "1.7.4",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "xstate": "6.0.0-beta.5"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@foldkit/vite-plugin": "0.29.1",
    "@oxlint/plugins": "1.95.0",
    "@playwright/cli": "0.1.25",
    "@tailwindcss/vite": "4.3.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.7",
    "@uinaf/oxlint-plugin-no-comments": "1.1.0",
    "knip": "6.48.0",
    "lefthook": "2.2.2",
    "oxlint": "1.95.0",
    "portless": "0.18.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}

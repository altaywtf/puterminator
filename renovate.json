{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>altaywtf/.github:renovate-config"],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "foldkit and alchemy each build on one Effect version, so they move in the same PR as effect and @effect/*: any one of them alone loads a second Effect and fails at deploy",
      "matchPackageNames": ["effect", "@effect/*", "foldkit", "@foldkit/*", "alchemy", "@alchemy.run/*"],
      "groupName": "effect",
      "internalChecksFilter": "none",
      "prCreation": "not-pending",
      "internalChecksAsSuccess": true,
      "separateMajorMinor": false
    }
  ]
}
